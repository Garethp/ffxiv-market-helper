{
  "name": "ffxiv-trading",
  "version": "1.0.0",
  "description": "FFXIV market board tracking helper, backed by the Universalis API",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "tsc -b && vite build",
    "analyze": "vite build --mode analyze",
    "lint": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "yarn typecheck && vitest run",
    "preview": "vite preview",
    "test:watch": "vitest",
    "format": "prettier --write ."
  },
  "packageManager": "yarn@4.18.0",
  "dependencies": {
    "@tanstack/react-query": "5.103.1",
    "idb": "8.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.9.6"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.1.0",
    "prettier": "3.9.7",
    "rollup-plugin-visualizer": "7.1.1",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
